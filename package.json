{
  "name": "hanma",
  "private": true,
  "scripts": {
    "build": "pnpm build:scripts && turbo run build && pnpm build:seo",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "build:registry": "tsx scripts/helpers/registry.ts",
    "build:modules": "tsx scripts/helpers/modules.ts",
    "build:templates": "tsx scripts/helpers/templates.ts",
    "build:snippets": "tsx scripts/helpers/extract-snippets.ts",
    "build:scripts": "pnpm build:registry && pnpm build:modules && pnpm build:templates && pnpm build:snippets",
    "build:seo": "tsx apps/web/scripts/seo-build/index.ts",
    "release": "tsx scripts/release.ts",
    "test:cli": "tsx scripts/tests/cli.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.1",
    "fs-extra": "^11.3.2",
    "js-yaml": "^4.1.1",
    "prettier": "^3.7.4",
    "satori": "^0.63.2",
    "tsx": "^4.21.0",
    "turbo": "^2.6.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
